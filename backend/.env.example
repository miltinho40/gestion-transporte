NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=http://localhost:4200

DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/transporte?schema=public"

JWT_SECRET="cambia-este-secreto-en-desarrollo"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# Asistente. Mantener "rules" permite usarlo sin consumir una API externa.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=10000
OPENAI_MIN_CONFIDENCE=0.55
# Tarifas USD del modelo por millon de tokens. Actualizarlas cuando cambie el modelo.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

# Opcional. Si no se configura SMTP_HOST, las invitaciones se generan pero no se envian por correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gestion Transporte <no-reply@localhost>"
